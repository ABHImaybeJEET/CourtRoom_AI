# ==========================================
# CourtRoom AI - Environment Configuration
# ==========================================

# [REQUIRED] Groq API Key for LLM Legal Reasoning
# Models used: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_API_KEY="your_groq_api_key_here"

# [OPTIONAL] Tavily API Key for Legal Case Law Precedent Search & Citation Grounding
# If omitted, external precedent search operates in offline demonstration mode.
TAVILY_API_KEY="your_tavily_api_key_here"

# [OPTIONAL] LangSmith Tracing & Observability
# Enables full hierarchical execution traces for LangGraph, agent chains, and tool invocations.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGCHAIN_PROJECT="courtroom-ai"
